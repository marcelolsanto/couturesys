# =============================================================================
# CoutureSys — Exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite o arquivo .env no repositório!
# =============================================================================

# Chave secreta do Django (gere uma nova com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=sua-secret-key-aqui

# Modo de depuração — use False em produção
DEBUG=True

# Hosts permitidos, separados por vírgula (use * apenas para desenvolvimento local)
# Exemplo produção: ALLOWED_HOSTS=meusite.com.br,www.meusite.com.br
ALLOWED_HOSTS=localhost,127.0.0.1,100.95.28.45,192.168.1.13,*
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,http://100.95.28.45:8001,http://192.168.1.13:8001

# ---- Banco de Dados (PostgreSQL) ----
DB_NAME=couturesys_db
DB_USER=postgres
DB_PASSWORD=sua-senha-aqui
DB_HOST=localhost
DB_PORT=5432

# ---- IAs Generativas (opcional) ----
# Deixe em branco para usar o modo offline (fallback automático)
GEMINI_API_KEY=
OPENAI_API_KEY=
